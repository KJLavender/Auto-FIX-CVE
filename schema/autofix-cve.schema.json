{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KJLavender/Auto-FIX-CVE/main/schema/autofix-cve.schema.json",
  "title": "Auto-FIX-CVE project file",
  "description": "Backports applied by `autofix-cve fix`, mitigations added by `autofix-cve mitigate`, and vulnerabilities the team accepted as risks.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "mitigations": {
      "description": "Written by `autofix-cve mitigate`: guards at the project's call sites for vulnerabilities with no fixed release. A mitigation counts only while its guard code is still in the files.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "vulns", "guards", "explanation", "residualRisk", "date"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "vulns": { "type": "array", "items": { "type": "string" } },
          "guards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "code"],
              "properties": { "file": { "type": "string" }, "code": { "type": "string" } }
            }
          },
          "explanation": { "type": "string" },
          "residualRisk": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "backports": {
      "description": "Written by `autofix-cve fix`; not meant to be edited by hand.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "vulns", "patch", "pocs", "fixCommits", "date"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "vulns": { "type": "array", "items": { "type": "string" } },
          "patch": { "type": "string" },
          "pocs": { "type": "array", "items": { "type": "string" } },
          "fixCommits": { "type": "array", "items": { "type": "string" } },
          "date": { "type": "string" }
        }
      }
    },
    "ignore": {
      "description": "Accepted risks. A rule without a reason, or past its `until` date, is not applied.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "GHSA, PYSEC, GO, RUSTSEC, CVE or Debian (DSA, DLA, DEBIAN-CVE) id.",
            "type": "string",
            "pattern": "^(GHSA-|PYSEC-|GO-|RUSTSEC-|CVE-|DSA-|DLA-|DEBIAN-)"
          },
          "package": { "description": "Limit the rule to one package.", "type": "string" },
          "reason": { "description": "Why this vulnerability is accepted.", "type": "string", "minLength": 1 },
          "until": { "description": "YYYY-MM-DD; reported again after this day.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "justification": {
            "description": "OpenVEX justification. With one, `scan --vex` states the package is not affected, so other scanners (Trivy --vex) suppress it too.",
            "enum": [
              "component_not_present",
              "vulnerable_code_not_present",
              "vulnerable_code_not_in_execute_path",
              "vulnerable_code_cannot_be_controlled_by_adversary",
              "inline_mitigations_already_exist"
            ]
          }
        }
      }
    }
  }
}
